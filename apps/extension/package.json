{
  "name": "@ez-gform/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "clean": "rm -rf .wxt .output dist"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@ez-gform/tsconfig": "workspace:*",
    "@wxt-dev/module-react": "^1.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wxt": "0.21.4"
  }
}
