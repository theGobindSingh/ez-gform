{
  "name": "@ez-gform/extension",
  "version": "0.1.0",
  "private": true,
  "displayName": "ez-gform",
  "description": "Generate ez-gform config and code from any Google Form",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx scripts/watcher.ts",
    "build": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src scripts --ext .ts",
    "lint:fix": "eslint src scripts --ext .ts --fix",
    "test": "vitest run",
    "zip": "tsx scripts/zip.ts"
  },
  "dependencies": {
    "@ez-gform/background": "workspace:*",
    "@ez-gform/content-script": "workspace:*",
    "@ez-gform/popup": "workspace:*"
  },
  "devDependencies": {
    "@ez-gform/tsconfig": "workspace:*",
    "@kami-ui/eslint-config": "0.0.6",
    "@types/node": "22.10.0",
    "@vitest/coverage-v8": "5.0.1",
    "chalk": "6.0.0",
    "chokidar": "5.0.0",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
